# Copy to .env and fill in locally. Never commit .env.
# All values are optional for local inference with `docker compose up --build`.

# Where training/evaluation scripts find the raw Stanford Cars data (original layout).
SEMEVIA_DATA_ROOT=D:/semevia_work/raw/StanfordCars/stanford_cars

# Durable artifact store for checkpoints and caches (outside Git).
SEMEVIA_ARTIFACT_STORE=D:/semevia_work/store

# Inference runtime
SEMEVIA_PORT=8000
SEMEVIA_TORCH_THREADS=2
SEMEVIA_MAX_UPLOAD_MB=10

# Optional: only needed if training on Kaggle (placeholder, do not commit a real token)
KAGGLE_USERNAME=<your-kaggle-username>
KAGGLE_KEY=<your-kaggle-api-key>
